# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Code Execution Engine (docker | local)
# Set to 'docker' to run in ephemeral containers, or 'local' for native isolated runner
EXECUTION_ENGINE=local
EXECUTION_TIMEOUT_MS=6000
CONTAINER_MEMORY_LIMIT=128m
CONTAINER_CPU_QUOTA=0.5

# Post-Interview AI Evaluation Provider (azure | gemini | openai | anthropic | heuristic)
# Default is 'heuristic' (instant deterministic offline analysis with zero external API required)
AI_EVALUATION_PROVIDER=azure

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_api_key
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-06-01

# Other AI Provider Keys (optional alternatives)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Public Host URL for Room Links (optional, defaults to current browser window location)
PUBLIC_APP_URL=

# Database Configuration (PostgreSQL / Neon / Supabase / Cloud SQL)
# Leave empty for automatic local file storage; provide connection string for cloud production
DATABASE_URL=
